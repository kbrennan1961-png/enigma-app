{
  "name": "enigma-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the Enigma interactive encrypt/decrypt app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.kbrennan.enigma",
    "productName": "Enigma",
    "files": ["main.js", "standalone.html"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
